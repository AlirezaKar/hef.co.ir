# Copy this file to .env and fill in real values.
# Never commit backend/.env

# Required — generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# Required — True only for local development
DJANGO_DEBUG=True

# Required — comma-separated hosts (no spaces required)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# HTTPS CSRF origin for production (example: https://portal.example.com)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your.domain.com

# PostgreSQL — required for Docker. Leave commented to use SQLite locally.
# POSTGRES_HOST is overridden to "postgres" inside Docker Compose.
POSTGRES_DB=hef
POSTGRES_USER=hef
POSTGRES_PASSWORD=hef

# Redis — set automatically by Docker Compose (REDIS_URL=redis://redis:6379/1).
# For local non-Docker Redis you can set:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=1
# Or: REDIS_URL=redis://127.0.0.1:6379/1
# Leave unset to use in-process LocMemCache with runserver.

# Optional — absolute path to history root (defaults to <project>/data/History)
# HISTORY_ROOT=

# Public domain for Caddy / Let's Encrypt (placeholder until you have one)
MY_DOMAIN=your.domain.com