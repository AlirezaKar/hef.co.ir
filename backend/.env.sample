# ──────────────────────────────────────────────────────────
#  HEF Portal — environment configuration
#  Copy this file to .env and fill in real values.
#  Never commit backend/.env
# ──────────────────────────────────────────────────────────

# ── Django core ────────────────────────────────────────────
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# True only for local development; False in production
DJANGO_DEBUG=True

# Comma-separated allowed hosts (no spaces)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# HTTPS CSRF origin — only needed in production (e.g. https://portal.example.com)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your.domain.com

# ── Security cookies (optional — defaults are safe for dev) ──
# DJANGO_SESSION_COOKIE_SECURE=False
# DJANGO_CSRF_COOKIE_SECURE=False
# DJANGO_SECURE_SSL_REDIRECT=False

# ── Database ───────────────────────────────────────────────
# PostgreSQL — required for Docker. Leave commented to use SQLite locally.
# (POSTGRES_HOST is overridden to "postgres" inside Docker Compose)
POSTGRES_DB=hef
POSTGRES_USER=hef
POSTGRES_PASSWORD=hef
# POSTGRES_HOST=
# POSTGRES_PORT=5432

# ── Redis / Cache ──────────────────────────────────────────
# Set automatically by Docker Compose (REDIS_URL=redis://redis:6379/1).
# For local non-Docker Redis uncomment and set one of the following:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=1
# REDIS_URL=redis://127.0.0.1:6379/1
# Leave all unset to use in-process LocMemCache with runserver.

# ── Static & media files ──────────────────────────────────
# DJANGO_STATIC_ROOT=/path/to/collected/static
# DJANGO_MEDIA_ROOT=/path/to/media

# ── CDN (download center files) ───────────────────────────
# DJANGO_CDN_ROOT=/path/to/cdn
# DJANGO_CDN_URL=/cdn/

# ── History data ───────────────────────────────────────────
# Absolute path to trading history root (defaults to <project>/data/History)
# HISTORY_ROOT=

# ── Carousel ───────────────────────────────────────────────
# Auto-advance interval in milliseconds (default: 4000 = 4 seconds)
# CAROUSEL_INTERVAL=4000

# ── Caddy / Let's Encrypt ──────────────────────────────────
# Your public domain (placeholder until you have one)
MY_DOMAIN=your.domain.com
