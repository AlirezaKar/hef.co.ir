# Copy this file to .env and fill in real values.
# Never commit backend/.env

# Required — generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# Required — True only for local development
DJANGO_DEBUG=True

# Required — comma-separated hosts (no spaces required)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Optional — PostgreSQL (leave unset to use SQLite locally)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=hef
# POSTGRES_USER=hef
# POSTGRES_PASSWORD=hef
# Or: DATABASE_URL=postgres://hef:hef@localhost:5432/hef

# Optional — absolute path to history root (defaults to <project>/data/History)
# HISTORY_ROOT=

# Public domain for Caddy / Let's Encrypt (placeholder until you have one)
MY_DOMAIN=your.domain.com